# =====================================================================
#  Kudłacze — zmienne środowiskowe
#  Skopiuj do .env (albo uruchom ./scripts/init-env.sh, który wygeneruje
#  losowe hasła i sekrety) i uzupełnij brakujące wartości.
#  Plik .env NIGDY nie trafia do repozytorium.
# =====================================================================

# --- Ogólne ----------------------------------------------------------
# Domena serwera (MOTD, komunikaty, DiscordSRV). Nigdzie nie jest wpisana na sztywno.
SERVER_DOMAIN=kudlacze.pl
TZ=Europe/Warsaw

# Na VPS odkomentuj, żeby docker compose NIE wczytywał docker-compose.override.yml
# (tam są zmniejszone limity pamięci do testów lokalnych):
# COMPOSE_FILE=docker-compose.yml

# --- Baza danych MariaDB ---------------------------------------------
MARIADB_ROOT_PASSWORD=
DB_NAME=kudlacze
DB_USER=kudlacze
DB_PASSWORD=

# --- Velocity modern forwarding (min. 32 losowe znaki) ---------------
VELOCITY_SECRET=

# --- RCON (tylko wewnętrzna sieć dockera, porty nie są wystawiane) ----
RCON_PASSWORD=

# --- Plugin core -------------------------------------------------------
# Sekret HMAC podpisujący fizyczne Kłaki Czarodzieja (ochrona przed podróbkami).
# Zmiana sekretu unieważnia wszystkie wypłacone przedmioty KC!
KC_ITEM_SECRET=

# --- Discord (DiscordSRV) ------------------------------------------------
# Pusty token = DiscordSRV nie łączy się z Discordem (serwer działa normalnie).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_CZAT_SURVIVAL=000000000000000000
DISCORD_CHANNEL_CZAT_SEASONS=000000000000000000
DISCORD_CHANNEL_LOGI_KAR=000000000000000000
DISCORD_CHANNEL_RANKING=000000000000000000
DISCORD_CHANNEL_SMOK=000000000000000000
DISCORD_CHANNEL_KONSOLA=000000000000000000
DISCORD_INVITE=https://discord.gg/zmien-mnie
# ID ról Discorda zsynchronizowanych z rangami w grze (0 = brak synchronizacji)
DISCORD_ROLE_VIP=0
DISCORD_ROLE_SVIP=0
DISCORD_ROLE_MVIP=0
DISCORD_ROLE_UVIP=0
DISCORD_ROLE_TYTAN=0
DISCORD_ROLE_DRWAL=0
DISCORD_ROLE_YOUTUBER=0
DISCORD_ROLE_POMOCNIK=0
DISCORD_ROLE_MODERATOR=0
DISCORD_ROLE_VICEADMIN=0
DISCORD_ROLE_ADMIN=0
DISCORD_ROLE_TECHNIK=0

# --- Resource pack serwera (model przedmiotu KC) ----------------------
# Zbuduj: ./scripts/build-resourcepack.sh, wrzuć ZIP na hosting HTTPS,
# wklej URL i SHA1 wypisane przez skrypt. Puste = brak paczki.
RESOURCE_PACK_URL=
RESOURCE_PACK_SHA1=
